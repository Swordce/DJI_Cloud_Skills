{
  "id": "mqtt-dock1-speaker-audio-play-start-progress-thing-product-gateway-sn-events",
  "name": "喊话器-音频播放进度通知",
  "purpose": "MQTT events: speaker_audio_play_start_progress",
  "protocol": "mqtt",
  "module": "psdk",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/events",
    "direction": "up",
    "method": "speaker_audio_play_start_progress",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "返回码",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "output",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "输出",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "psdk_index",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "psdk 负载设备索引",
      "constraints": "{\"min\":0}",
      "schema": "int",
      "parent": "output"
    },
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前所处阶段",
      "constraints": "{\"in_progress\":\"处理中\",\"ok\":\"播放成功\"}",
      "schema": "enum_string",
      "parent": "output"
    },
    {
      "name": "md5",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件内容的md5校验和, 用作机场唯一标识",
      "constraints": "",
      "schema": "text",
      "parent": "output"
    },
    {
      "name": "progress",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度",
      "constraints": "",
      "schema": "struct",
      "parent": "output"
    },
    {
      "name": "percent",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度百分比",
      "constraints": "{\"max\":\"100\",\"min\":\"0\",\"step\":\"1\",\"unit_name\":\"百分比 / %\"}",
      "schema": "int",
      "parent": "progress"
    },
    {
      "name": "step_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前步骤",
      "constraints": "{\"change_work_mode\":\"切换工作模式\",\"download\":\"从云端下载音频文件到机场\",\"encoding\":\"编码pcm为opus\",\"play\":\"开始播放\",\"upload\":\"机场上传音频到psdk\"}",
      "schema": "enum_string",
      "parent": "progress"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "data": {
          "output": {
            "md5": "e0ecd29bb44d9e08107aaccecdc6cae2",
            "progress": {
              "percent": 89,
              "step_key": "upload"
            },
            "psdk_index": 2,
            "status": "in_progress"
          },
          "result": 0
        },
        "gateway": "4TADKAQ000002J",
        "method": "speaker_audio_play_start_progress",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "timestamp": 1689868551258
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/140.psdk.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock1/psdk.html",
    "sha256": "4ebc27ff1080d227ab8a9a83764d3b0bdc3cc429defe5fad9529f1fea4225948",
    "asset_sha256": "14dfc7b1ec57897091144fa67fdaa522a1af349001bd26cd8bad8287bb60c36c",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
