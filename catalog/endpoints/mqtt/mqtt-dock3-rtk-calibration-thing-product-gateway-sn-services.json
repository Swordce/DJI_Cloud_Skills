{
  "id": "mqtt-dock3-rtk-calibration-thing-product-gateway-sn-services",
  "name": "一键标定",
  "purpose": "MQTT services: rtk_calibration",
  "protocol": "mqtt",
  "module": "cmd",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/services",
    "direction": "down",
    "method": "rtk_calibration",
    "reply_topic": "thing/product/{gateway_sn}/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "devices",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "标定设备集合",
      "constraints": "{\"size\": \"-\", \"item_type\": \"struct\" }",
      "schema": "array"
    },
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备序列号（SN）",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text",
      "parent": "devices"
    },
    {
      "name": "type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "标定类型",
      "constraints": "{\"1\": \"手动标定\"}",
      "schema": "enum_int",
      "parent": "devices"
    },
    {
      "name": "module",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "模块枚举值",
      "constraints": "{\"3\": \"机场\", \"6\": \"中继\" }",
      "schema": "enum_string",
      "parent": "devices"
    },
    {
      "name": "data",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "标定数据",
      "constraints": "",
      "schema": "struct",
      "parent": "devices"
    },
    {
      "name": "longitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "经度",
      "constraints": "",
      "schema": "double",
      "parent": "data"
    },
    {
      "name": "latitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "纬度",
      "constraints": "",
      "schema": "double",
      "parent": "data"
    },
    {
      "name": "height",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "高度",
      "constraints": "",
      "schema": "double",
      "parent": "data"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp:": 1654070968655,
        "method": "rtk_calibration",
        "data": {
          "devices": [
            {
              "sn": "string",
              "type": 1,
              "module": "3",
              "data": {
                "height": 60.285194396972656,
                "latitude": 22.755022128112614,
                "longitude": 114.89828051067889
              }
            }
          ]
        }
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/20.dock3/70.cmd.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock3/cmd.html",
    "sha256": "6b0224f38b262284ce92deaffe66a73678b629098acb2bd017840ff7a4d6c0e6",
    "asset_sha256": "f686a93d92c4c31ccae86dfbf6817779c63bcbbe4ca915853fa893521d6a4b15",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
