{
  "id": "mqtt-property-air-conditioner-state",
  "name": "»air_conditioner_state",
  "purpose": "机场空调工作状态信息，空调仅存在一种工作模式",
  "protocol": "mqtt",
  "module": "device-properties",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{device_sn}*/state 状态数据:设备在状态变化时上报",
    "direction": "up",
    "method": "property_report"
  },
  "parameters": [
    {
      "name": "»air_conditioner_state",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "机场空调工作状态信息，空调仅存在一种工作模式",
      "constraints": "{\"0\":\"空闲模式(无制冷、制热、除湿等)\",\"1\":\"制冷模式\",\"2\":\"制热模式\",\"3\":\"除湿模式\",\"4\":\"制冷退出模式\",\"5\":\"制热退出模式\",\"6\":\"除湿退出模式\",\"7\":\"制冷准备模式\",\"8\":\"制热准备模式\",\"9\":\"除湿准备模式\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "payload_field": "data.»air_conditioner_state"
    }
  ],
  "errors": [],
