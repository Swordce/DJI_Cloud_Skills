{
  "id": "mqtt-poi-status-notify",
  "name": "飞行控制—POI 环绕状态信息通知",
  "purpose": "MQTT events: poi_status_notify",
  "protocol": "mqtt",
  "module": "drc",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/events",
    "direction": "up",
    "method": "poi_status_notify",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "状态",
      "constraints": "{\"failed\":\"执行失败\",\"in_progress\":\"执行中\",\"ok\":\"执行成功\"}",
      "schema": "enum_string"
    },
    {
      "name": "reason",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "结果返回码",
      "constraints": "{\"0\":\"正常\",\"1\":\"未适配负载\",\"2\":\"不支持该相机模式\",\"3\":\"非法命令\",\"4\":\"定位失败\",\"5\":\"飞行器未起飞\",\"6\":\"飞行模式错误\",\"7\":\"该模式下不可用（返航、降落、姿态）\",\"8\":\"丢失遥控器或图传信号\"}",
      "schema": "int"
    },
    {
      "name": "circle_radius",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "环绕半径",
      "constraints": "{\"unit_name\":\"米 / m\"}",
      "schema": "float"
    },
    {
      "name": "circle_speed",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "环绕速度",
      "constraints": "{\"unit_name\":\"米每秒 / m/s\"}",
      "schema": "float"
    },
    {
      "name": "max_circle_speed",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "最大环绕速度",
      "constraints": "{\"unit_name\":\"米每秒 / m/s\"}",
      "schema": "float"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "circle_radius": 10.1,
          "circle_speed": 100.1,
          "max_circle_speed": 200.2,
          "reason": 0,
          "status": "in_progress"
        },
        "need_reply": 1,
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 16540709686556,
        "method": "poi_status_notify"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/110.drc.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/110.drc.md"
  }
}
