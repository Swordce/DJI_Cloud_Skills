{
  "id": "mqtt-dock2-drc-camera-dewarping-set-thing-product-gateway-sn-drc-down",
  "name": "负载控制—镜头去畸变",
  "purpose": "MQTT message: drc_camera_dewarping_set",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "drc_camera_dewarping_set",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "camera_type",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机类型枚举",
      "constraints": "{\"wide\":\"广角\"}",
      "schema": "enum_string"
    },
    {
      "name": "dewarping_state",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "开启还是关闭畸变",
      "constraints": "{\"0\":\"关闭\",\"1\":\"开启\"}",
      "schema": "enum_int"
    },
    {
      "name": "payload_index",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机枚举",
      "constraints": "",
      "schema": "text"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "camera_type": "wide",
          "dewarping_state": 1,
          "payload_index": "39-0-7"
        },
        "method": "drc_camera_dewarping_set",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_camera_dewarping_set",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock2"
  ],
  "deprecated": false,
