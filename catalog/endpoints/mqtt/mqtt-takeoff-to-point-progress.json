{
  "id": "mqtt-takeoff-to-point-progress",
  "name": "一键起飞结果事件通知",
  "purpose": "MQTT events: takeoff_to_point_progress",
  "protocol": "mqtt",
  "module": "drc",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/events",
    "direction": "up",
    "method": "takeoff_to_point_progress",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "任务状态",
      "constraints": "{\"task_finish\":\"一键起飞任务完成\",\"task_ready\":\"准备起飞\",\"wayline_cancel\":\"取消飞向目标点\",\"wayline_failed\":\"执行失败\",\"wayline_ok\":\"执行成功，已飞向目标点\",\"wayline_progress\":\"执行中\"}",
      "schema": "enum_string"
    },
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "非 0 代表错误",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "flight_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "一键起飞任务 UUID",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "track_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航迹 ID",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "way_point_index",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前执行到第几个航点",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "remaining_distance",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "剩余任务距离",
      "constraints": "{\"step\":0.1,\"unit_name\":\"米 / m\"}",
      "schema": "float"
    },
    {
      "name": "remaining_time",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "剩余任务时间",
      "constraints": "{\"step\":0.1,\"unit_name\":\"秒 / s\"}",
      "schema": "float"
    },
    {
      "name": "planned_path_points",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "规划的轨迹点列表",
      "constraints": "{\"size\": -, \"item_type\": struct}",
      "schema": "array"
    },
    {
      "name": "latitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "轨迹点纬度，角度值，南纬是负，北纬是正，精度到小数点后6位",
      "constraints": "{\"max\":90,\"min\":-90}",
      "schema": "double"
    },
    {
      "name": "longitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "轨迹点经度，角度值，东经是正，西经是负，精度到小数点后6位",
      "constraints": "{\"max\":180,\"min\":-180}",
      "schema": "double"
    },
    {
      "name": "height",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "轨迹点高度，椭球高",
      "constraints": "{\"step\":0.1,\"unit_name\":\"米 / m\"}",
      "schema": "float"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "flight_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
          "planned_path_points": [
            {
              "height": 123.234,
              "latitude": 13.23,
              "longitude": 123.234
            }
          ],
          "remaining_distance": 0,
          "remaining_time": 0,
          "result": 0,
          "status": "wayline_ok",
          "track_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
          "way_point_index": 1
        },
        "need_reply": 1,
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 16540709686556,
        "method": "takeoff_to_point_progress"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/110.drc.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/110.drc.md"
  },
  "alternate_sources": [
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/110.drc.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/110.drc.md"
    }
  ]
}
