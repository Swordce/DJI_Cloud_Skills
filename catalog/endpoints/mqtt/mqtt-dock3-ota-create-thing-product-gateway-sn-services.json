{
  "id": "mqtt-dock3-ota-create-thing-product-gateway-sn-services",
  "name": "固件升级",
  "purpose": "MQTT services: ota_create",
  "protocol": "mqtt",
  "module": "firmware",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/services",
    "direction": "down",
    "method": "ota_create",
    "reply_topic": "thing/product/{gateway_sn}/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "devices",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件升级设备集合",
      "constraints": "{\"size\": 2, \"item_type\": struct}",
      "schema": "array"
    },
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备序列号（SN）",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text",
      "parent": "devices"
    },
    {
      "name": "product_version",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件版本",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text",
      "parent": "devices"
    },
    {
      "name": "file_url",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件下载地址",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text",
      "parent": "devices"
    },
    {
      "name": "md5",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件 MD5",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text",
      "parent": "devices"
    },
    {
      "name": "file_size",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件大小",
      "constraints": "",
      "schema": "int",
      "parent": "devices"
    },
    {
      "name": "file_name",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件名称",
      "constraints": "",
      "schema": "text",
      "parent": "devices"
    },
    {
      "name": "firmware_upgrade_type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件升级类型",
      "constraints": "{\"2\":\"一致性升级\",\"3\":\"普通升级\",\"4\":\"PSDK升级\"}",
      "schema": "enum_int",
      "parent": "devices"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "devices": [
            {
              "file_name": "wm245_1.00.223.zip",
              "file_size": 653467234,
              "file_url": "https://s3.com/xxx.zip",
              "firmware_upgrade_type": 2,
              "md5": "abcdefabcdefabcdef",
              "product_version": "1.00.223",
              "sn": "drone_sn"
            },
            {
              "firmware_upgrade_type": 3,
              "product_version": "1.00.223",
              "sn": "dock_sn"
            }
          ]
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "ota_create"
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "status": "in_progress"
          },
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "ota_create"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/20.dock3/80.firmware.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock3/firmware.html",
    "sha256": "dd265ec83b6db2ea46d41e4083cd385d7c216d73d4be5a41b502f39bf1222b32",
    "asset_sha256": "031c84bb488d32ec319dfd22e4247486c42cd1a5c27e292e8162c293b9579083",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
