{
  "id": "mqtt-camera-photo-take-progress",
  "name": "上报拍照进度",
  "purpose": "MQTT events: camera_photo_take_progress",
  "protocol": "mqtt",
  "module": "drc",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/events",
    "direction": "up",
    "method": "camera_photo_take_progress",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "output",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "输出",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍照状态",
      "constraints": "{\"fail\":\"失败\",\"in_progress\":\"执行中\",\"ok\":\"完成\"}",
      "schema": "enum_string"
    },
    {
      "name": "progress",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "current_step",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "执行步骤",
      "constraints": "{\"3000\":\"全景图拍摄未开始或者已结束\",\"3002\":\"全景图正在拍摄\",\"3005\":\"全景图合成中\"}",
      "schema": "enum_int"
    },
    {
      "name": "percent",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度值",
      "constraints": "{\"max\":\"100\",\"min\":\"0\",\"step\":\"1\"}",
      "schema": "int"
    },
    {
      "name": "ext",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "扩展内容",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "camera_mode",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前相机模式",
      "constraints": "{\"3\":\"全景拍照\"}",
      "schema": "enum_int"
    },
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "非 0 代表错误",
      "constraints": "",
      "schema": "int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "ext": {
              "camera_mode": 3
            },
            "progress": {
              "current_step": 0,
              "percent": 100
            },
            "status": "ok"
          },
          "result": 0
        },
        "need_reply": 1,
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "camera_photo_take_progress"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2",
    "pilot"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/30.drc.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/30.drc.md"
  },
  "alternate_sources": [
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/110.drc.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/110.drc.md"
    },
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/110.drc.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/110.drc.md"
    }
  ]
}
