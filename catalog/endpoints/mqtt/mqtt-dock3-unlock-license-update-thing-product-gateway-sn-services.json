{
  "id": "mqtt-dock3-unlock-license-update-thing-product-gateway-sn-services",
  "name": "更新设备的解禁证书",
  "purpose": "MQTT services: unlock_license_update",
  "protocol": "mqtt",
  "module": "flysafe",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/services",
    "direction": "down",
    "method": "unlock_license_update",
    "reply_topic": "thing/product/{gateway_sn}/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "file",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "可缺省，按照 Flysafe 服务器最新证书进行更新",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "url",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件 URL",
      "constraints": "",
      "schema": "text",
      "parent": "file"
    },
    {
      "name": "fingerprint",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件 MD5 签名",
      "constraints": "",
      "schema": "text",
      "parent": "file"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "file": {
            "fingerprint": "xxxx",
            "url": "https://xx.oss-cn-hangzhou.aliyuncs.com/xx.kmz?Expires=xx&OSSAccessKeyId=xxx&Signature=xxx"
          }
        },
        "method": "unlock_license_update",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "result": 0
        },
        "method": "unlock_license_update",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1234567890123
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/20.dock3/170.flysafe.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock3/flysafe.html",
    "sha256": "6490226a752301d9accf28be79f8262c1b58d44f946b0a07ea39cdd5c710cf29",
    "asset_sha256": "216562dfa24a8277957169e5e357c48754749137ec6be3a60ddede5294ad8986",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
