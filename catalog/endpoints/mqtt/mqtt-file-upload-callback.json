{
  "id": "mqtt-file-upload-callback",
  "name": "媒体文件上传结果上报",
  "purpose": "MQTT events: file_upload_callback",
  "protocol": "mqtt",
  "module": "file",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/events",
    "direction": "up",
    "method": "file_upload_callback",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "file",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件信息",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "object_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件在对象存储桶的 Key",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "path",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件的业务路径",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "name",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件名称",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "ext",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件扩展内容",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "flight_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "任务 ID",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "drone_model_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "飞行器产品枚举值",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "payload_model_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "负载产品枚举值",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "is_original",
      "in": "payload",
      "type": "boolean",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "是否为原图",
      "constraints": "{\"0\":\"否\",\"1\":\"是\"}",
      "schema": "bool"
    },
    {
      "name": "metadata",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "媒体元数据",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "gimbal_yaw_degree",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "云台偏航角",
      "constraints": "",
      "schema": "float"
    },
    {
      "name": "absolute_altitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍摄绝对高度",
      "constraints": "",
      "schema": "float"
    },
    {
      "name": "relative_altitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍摄相对高度",
      "constraints": "",
      "schema": "float"
    },
    {
      "name": "create_time",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "媒体拍摄时间",
      "constraints": "{\"format\":\"iso8601\"}",
      "schema": "date"
    },
    {
      "name": "shoot_position",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍摄位置",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "lat",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍摄位置纬度",
      "constraints": "",
      "schema": "float"
    },
    {
      "name": "lng",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍摄位置经度",
      "constraints": "",
      "schema": "float"
    },
    {
      "name": "cloud_to_cloud_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "该媒体上传到的存储桶 id，若未上传到云云对接存储桶中，该字段的值为 'DEFAULT'",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "flight_task",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "飞行任务信息",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "uploaded_file_count",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "该飞行架次当前已上传媒体数量",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "expected_file_count",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "该飞行架次拍摄媒体总数量",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "flight_type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "飞行类型枚举值",
      "constraints": "{\"0\":\"航线任务\",\"1\":\"一键起飞任务\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "file": {
            "cloud_to_cloud_id": "DEFAULT",
            "ext": {
              "drone_model_key": "0-67-0",
              "flight_id": "xxx",
              "is_original": true,
              "payload_model_key": "0-67-0"
            },
            "metadata": {
              "absolute_altitude": 56.311,
              "create_time": "2021-05-10 16:04:20",
              "gimbal_yaw_degree": "-91.40",
              "relative_altitude": 41.124,
              "shoot_position": {
                "lat": 22.1,
                "lng": 122.5
              }
            },
            "name": "dog.jpeg",
            "object_key": "object_key",
            "path": "xxx"
          },
          "flight_task": {
            "expected_file_count": 14,
            "flight_type": 0,
            "uploaded_file_count": 12
          }
        },
        "gateway": "xxx",
        "method": "file_upload_callback",
        "need_reply": 1,
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655
      },
      "source": "official"
    },
    {
      "kind": "response",
      "format": "json",
      "value": {
        "bid": "00000000-0000-0000-0000-000000000000",
        "data": {
          "result": 0
        },
        "method": "file_upload_callback",
        "tid": "00000000-0000-0000-0000-000000000000",
        "timestamp": 0
      },
      "source": "generated_from_schema"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/40.file.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/40.file.md"
  },
  "alternate_sources": [
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/40.file.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/40.file.md"
    }
  ]
}
