{
  "id": "mqtt-update-topo",
  "name": "设备拓扑更新",
  "purpose": "MQTT message: update_topo",
  "protocol": "mqtt",
  "module": "device",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/status",
    "direction": "up",
    "method": "update_topo",
    "reply_topic": "sys/product/{gateway_sn}/status_reply",
    "reply_direction": "down"
  },
  "parameters": [
    {
      "name": "domain",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "参考：产品支持",
      "constraints": "",
      "schema": "string"
    },
    {
      "name": "type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "参考：产品支持",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "sub_type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "参考：产品支持",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "device_secret",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "网关设备的密钥",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "nonce",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "nonce",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "thing_version",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "网关设备的物模型版本",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "sub_devices",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "子设备列表",
      "constraints": "{\"size\": 1, \"item_type\": struct}",
      "schema": "array"
    },
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "子设备序列号（SN）",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "index",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "连接网关设备的通道索引",
      "constraints": "",
      "schema": "string"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "sys/product/{gateway_sn}/status_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "update_topo"
      },
      "source": "official"
    },
    {
      "kind": "response",
      "format": "json",
      "value": {
        "bid": "00000000-0000-0000-0000-000000000000",
        "data": {
          "result": 0
        },
        "method": "update_topo",
        "tid": "00000000-0000-0000-0000-000000000000",
        "timestamp": 0
      },
      "source": "generated_from_schema"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2",
    "pilot"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/10.device.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/10.device.md"
  },
  "alternate_sources": [
    {
      "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/30.others/20.rc/10.device.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/30.others/20.rc/10.device.md"
    },
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/10.device.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/10.device.md"
    },
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/10.device.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/10.device.md"
    }
  ]
}
