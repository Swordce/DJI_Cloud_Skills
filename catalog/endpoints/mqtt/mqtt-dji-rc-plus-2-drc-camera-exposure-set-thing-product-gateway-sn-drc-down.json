{
  "id": "mqtt-dji-rc-plus-2-drc-camera-exposure-set-thing-product-gateway-sn-drc-down",
  "name": "负载控制—相机曝光值调节",
  "purpose": "MQTT message: drc_camera_exposure_set",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "drc_camera_exposure_set",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "camera_type",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机类型",
      "constraints": "{\"wide\":\"广角\",\"zoom\":\"变焦\"}",
      "schema": "enum_string"
    },
    {
      "name": "exposure_value",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "曝光值",
      "constraints": "{\"1\":\"-5.0EV\",\"2\":\"-4.7EV\",\"3\":\"-4.3EV\",\"4\":\"-4.0EV\",\"5\":\"-3.7EV\",\"6\":\"-3.3EV\",\"7\":\"-3.0EV\",\"8\":\"-2.7EV\",\"9\":\"-2.3EV\",\"10\":\"-2.0EV\",\"11\":\"-1.7EV\",\"12\":\"-1.3EV\",\"13\":\"-1.0EV\",\"14\":\"-0.7EV\",\"15\":\"-0.3EV\",\"16\":\"0EV\",\"17\":\"0.3EV\",\"18\":\"0.7EV\",\"19\":\"1.0EV\",\"20\":\"1.3EV\",\"21\":\"1.7EV\",\"22\":\"2.0EV\",\"23\":\"2.3EV\",\"24\":\"2.7EV\",\"25\":\"3.0EV\",\"26\":\"3.3EV\",\"27\":\"3.7EV\",\"28\":\"4.0EV\",\"29\":\"4.3EV\",\"30\":\"4.7EV\",\"31\":\"5.0EV\",\"255\":\"FIXED\"}",
      "schema": "enum_string"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "camera_type": "zoom",
          "exposure_value": 8,
          "payload_index": "89-0-0"
        },
        "method": "drc_camera_exposure_set",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_camera_exposure_set",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dji-rc-plus-2"
  ],
  "deprecated": false,
