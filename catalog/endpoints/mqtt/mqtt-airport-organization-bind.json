{
  "id": "mqtt-airport-organization-bind",
  "name": "设备绑定到组织",
  "purpose": "MQTT requests: airport_organization_bind",
  "protocol": "mqtt",
  "module": "organization",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/requests",
    "direction": "up",
    "method": "airport_organization_bind",
    "reply_topic": "thing/product/*{gateway_sn}*/requests_reply",
    "reply_direction": "down"
  },
  "parameters": [
    {
      "name": "bind_devices",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "绑定参数列表",
      "constraints": "{\"size\": 2, \"item_type\": struct}",
      "schema": "array"
    },
    {
      "name": "device_binding_code",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备绑定码",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "organization_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "组织 ID",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "device_callsign",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备在组织中的名称",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备序列号（SN）",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "device_model_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "参考：产品支持",
      "constraints": "",
      "schema": "text"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/requests_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "bind_devices": [
            {
              "device_binding_code": "device_binding_code",
              "device_callsign": "dock-device-callsign",
              "device_model_key": "3-1-0",
              "organization_id": "organization_id",
              "sn": "dock-sn"
            },
            {
              "device_binding_code": "device_binding_code",
              "device_callsign": "drone-device-callsign",
              "device_model_key": "0-67-0",
              "organization_id": "organization_id",
              "sn": "drone-sn"
            }
          ]
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "airport_organization_bind"
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "err_infos": [
              {
                "err_code": 210231,
                "sn": "dock-sn"
              },
              {
                "err_code": 210231,
                "sn": "drone-sn"
              }
            ]
          },
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "airport_organization_bind"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/20.organization.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/20.organization.md"
  },
  "alternate_sources": [
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/20.organization.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/20.organization.md"
    }
  ]
}
