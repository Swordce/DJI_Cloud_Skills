{
  "id": "mqtt-dock2-flight-areas-get-thing-product-gateway-sn-requests",
  "name": "自定义飞行区文件获取",
  "purpose": "MQTT requests: flight_areas_get",
  "protocol": "mqtt",
  "module": "custom-flight-area",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/requests",
    "direction": "up",
    "method": "flight_areas_get",
    "reply_topic": "thing/product/{gateway_sn}/requests_reply",
    "reply_direction": "down"
  },
  "parameters": [
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "非 0 代表错误",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "output",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "输出",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "files",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "没有自定义飞行区则为空数组",
      "constraints": "{\"size\": -, \"item_type\": struct}",
      "schema": "array",
      "parent": "output"
    },
    {
      "name": "name",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件名",
      "constraints": "{}",
      "schema": "text",
      "parent": "files"
    },
    {
      "name": "url",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件 URL",
      "constraints": "{}",
      "schema": "text",
      "parent": "files"
    },
    {
      "name": "checksum",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件 SHA256 签名",
      "constraints": "{}",
      "schema": "text",
      "parent": "files"
    },
    {
      "name": "size",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件大小",
      "constraints": "{}",
      "schema": "int",
      "parent": "files"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/requests_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": null,
        "method": "flight_areas_get",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "files": [
              {
                "checksum": "sha256",
                "name": "geofence_xxx.json",
                "size": 500,
                "url": "https://xx.oss-cn-hangzhou.aliyuncs.com/xx.json?Expires=xx&OSSAccessKeyId=xxx&Signature=xxx"
              }
            ]
          },
          "result": 0
        },
        "method": "flight_areas_get",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/130.custom-flight-area.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock2/custom-flight-area.html",
