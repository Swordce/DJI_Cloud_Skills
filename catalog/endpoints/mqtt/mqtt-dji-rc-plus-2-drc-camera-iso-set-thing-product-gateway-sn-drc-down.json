{
  "id": "mqtt-dji-rc-plus-2-drc-camera-iso-set-thing-product-gateway-sn-drc-down",
  "name": "负载控制—ISO设置",
  "purpose": "MQTT message: drc_camera_iso_set",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "drc_camera_iso_set",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "camera_type",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机类型枚举",
      "constraints": "{\"wide\":\"广角\",\"zoom\":\"变焦\"}",
      "schema": "enum_string"
    },
    {
      "name": "iso_value",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "不同机型范围不一样",
      "constraints": "{\"0\":\"ISO_AUTO\",\"2\":\"ISO_50\",\"3\":\"ISO_100\",\"4\":\"ISO_200\",\"5\":\"ISO_400\",\"6\":\"ISO_800\",\"7\":\"ISO_1600\",\"8\":\"ISO_3200\",\"9\":\"ISO_6400\",\"10\":\"ISO_12800\",\"11\":\"ISO_25600\",\"12\":\"ISO_51200\",\"13\":\"ISO_102400\",\"255\":\"ISO_FIXED\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "camera_type": "zoom",
          "iso_value": 5,
          "payload_index": "89-0-0"
        },
        "method": "drc_camera_iso_set",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_camera_iso_set",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dji-rc-plus-2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/40.dji-rc-plus-2/40.remote-control.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/pilot-to-cloud/mqtt/dji-rc-plus-2/remote-control.html",
    "sha256": "474d36810f777c08b1b3fb174e4189f13771bddafbae9733e80340129722c51c",
    "asset_sha256": "144d7b7a36f3bdb787b59cd873902ee5cababf391e650ddba7dcec46adfa9cd2",
