    "asset_sha256": "0576c1465474a500ddbae5c8635386c3043974d44ff1ae5da5914a8ca41924eb",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
