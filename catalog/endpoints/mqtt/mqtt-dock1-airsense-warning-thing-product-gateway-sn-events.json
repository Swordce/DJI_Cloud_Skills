{
  "id": "mqtt-dock1-airsense-warning-thing-product-gateway-sn-events",
  "name": "Airsense 告警通知",
  "purpose": "MQTT events: airsense_warning",
  "protocol": "mqtt",
  "module": "airsense",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/events",
    "direction": "up",
    "method": "airsense_warning",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "icao",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "ICAO 民用航空飞机地址",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "warning_level",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "危险等级越高越危险，等级大于等于3建议无人机避让",
      "constraints": "{\"0\":\"无危险\",\"1\":\"等级一\",\"2\":\"等级二\",\"3\":\"等级三\",\"4\":\"等级四\"}",
      "schema": "enum_int"
    },
    {
      "name": "latitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "飞机所在位置点纬度，角度值，南纬是负，北纬是正，精度到小数点后6位",
      "constraints": "{\"max\":90,\"min\":-90}",
      "schema": "float"
    },
    {
      "name": "longitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "飞机所在位置点经度，角度值，东经是正，西经是负，精度到小数点后6位",
      "constraints": "{\"max\":180,\"min\":-180}",
      "schema": "float"
    },
    {
      "name": "altitude",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航班绝对高度，单位是米",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "altitude_type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "绝对高度类型",
      "constraints": "{\"0\":\"椭球高\",\"1\":\"海拔高\"}",
      "schema": "enum_int"
    },
    {
      "name": "heading",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航向角度，角度值，0为正北方向，90为正东方向，精度到小数点后1位",
      "constraints": "",
      "schema": "float"
    },
    {
      "name": "relative_altitude",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航班相对无人机高度，单位是米",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "vert_trend",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相对高度变化趋势",
      "constraints": "{\"0\":\"相对高度不变\",\"1\":\"相对高度上升\",\"2\":\"相对高度下降\"}",
      "schema": "enum_int"
    },
    {
      "name": "distance",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航班与无人机的水平距离",
      "constraints": "{\"unit_name\":\"米 / m\"}",
      "schema": "int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": [
          {
            "altitude": 100,
            "altitude_type": 1,
            "distance": 100,
            "heading": 89.1,
            "icao": "B-5931",
            "latitude": 12.23,
            "longitude": 12.23,
            "relative_altitude": 80,
            "vert_trend": 0,
            "warning_level": 3
          }
        ],
        "need_reply": 1,
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 16540709686556,
        "method": "airsense_warning"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/120.airsense.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock1/airsense.html",
    "sha256": "75357df2c1343e81338a6210a17974746b83b29aff55e8889f4cc588298100b5",
    "asset_sha256": "6dfade5dacf511337c58df6d5b1e360ebc5550bfc87f47d820f2d4ebaf1e3775",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
