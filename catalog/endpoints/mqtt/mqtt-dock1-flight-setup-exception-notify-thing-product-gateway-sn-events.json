{
  "id": "mqtt-dock1-flight-setup-exception-notify-thing-product-gateway-sn-events",
  "name": "机场任务准备异常通知",
  "purpose": "MQTT events: flight_setup_exception_notify",
  "protocol": "mqtt",
  "module": "wayline",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/events",
    "direction": "up",
    "method": "flight_setup_exception_notify",
    "reply_topic": "thing/product/{gateway_sn}/events_reply",
    "reply_direction": "down"
  },
  "parameters": [
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "机场SN",
      "constraints": "{\"length\":\"\"}",
      "schema": "text"
    },
    {
      "name": "timeout_time",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "异常超时时间",
      "constraints": "{\"max\":\"10\",\"min\":\"2\",\"step\":\"2\",\"unit_name\":\"分钟 / min\"}",
      "schema": "int"
    },
    {
      "name": "timestamp",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前UTC时间",
      "constraints": "",
      "schema": "double"
    },
    {
      "name": "flight_type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "1表示航线任务，2表示指令飞行任务",
      "constraints": "{\"max\":\"2\",\"min\":\"1\",\"step\":\"\",\"unit_name\":null}",
      "schema": "int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/events_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "34bb18e0-ecbc-45c5-89a8-0d4b1689f499",
        "data": {
          "flight_id": "c7f17df6-e7cc-4465-a252-d9587c6bbb37",
          "flight_type": 1,
          "sn": "xxxxxxxx",
          "timeout_time": 6,
          "timestamp": 1724126480015
        },
        "gateway": "xxxxxxxx",
        "method": "flight_setup_exception_notify",
        "need_reply": 1,
        "tid": "d6503c74-65ad-448a-b9f5-916dc1b00acb",
        "timestamp": 1724126480015
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1234567890123,
        "method": "flight_setup_exception_notify"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/50.wayline.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock1/wayline.html",
    "sha256": "f45121b90cb8320558dab11ca4809fbcadf33e3c5f3afa04bf9e16069c9d4363",
    "asset_sha256": "63c2767490f70be5e69a4cf82db0687a8aa11924732d9dbba73f41623d572ece",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
