{
  "id": "mqtt-dock1-airport-organization-bind-thing-product-gateway-sn-requests",
  "name": "设备绑定到组织",
  "purpose": "MQTT requests: airport_organization_bind",
  "protocol": "mqtt",
  "module": "organization",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/requests",
    "direction": "up",
    "method": "airport_organization_bind",
    "reply_topic": "thing/product/{gateway_sn}/requests_reply",
    "reply_direction": "down"
  },
  "parameters": [
    {
      "name": "bind_devices",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "绑定参数列表",
      "constraints": "{\"size\": 2, \"item_type\": struct}",
      "schema": "array"
    },
    {
      "name": "device_binding_code",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备绑定码",
      "constraints": "",
      "schema": "text",
      "parent": "bind_devices"
    },
    {
      "name": "organization_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "组织 ID",
      "constraints": "",
      "schema": "text",
      "parent": "bind_devices"
    },
    {
      "name": "device_callsign",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备在组织中的名称",
      "constraints": "",
      "schema": "text",
      "parent": "bind_devices"
    },
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备序列号（SN）",
      "constraints": "",
      "schema": "text",
      "parent": "bind_devices"
    },
    {
      "name": "device_model_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "产品枚举值",
      "constraints": "",
      "schema": "text",
      "parent": "bind_devices"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/requests_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "bind_devices": [
            {
              "device_binding_code": "device_binding_code",
              "device_callsign": "dock-device-callsign",
              "device_model_key": "3-1-0",
              "organization_id": "organization_id",
              "sn": "dock-sn"
            },
            {
              "device_binding_code": "device_binding_code",
              "device_callsign": "drone-device-callsign",
              "device_model_key": "0-67-0",
              "organization_id": "organization_id",
              "sn": "drone-sn"
            }
          ]
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "airport_organization_bind"
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "err_infos": [
              {
                "err_code": 210231,
                "sn": "dock-sn"
              },
              {
                "err_code": 210231,
                "sn": "drone-sn"
              }
            ]
          },
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "airport_organization_bind"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/20.organization.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock1/organization.html",
