    "asset_sha256": "1f1f4e3b249cc25c6e590d4a421f7480702cc8f259002191cd32129acb556495",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
