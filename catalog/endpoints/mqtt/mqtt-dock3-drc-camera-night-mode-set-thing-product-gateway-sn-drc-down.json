{
  "id": "mqtt-dock3-drc-camera-night-mode-set-thing-product-gateway-sn-drc-down",
  "name": "夜景模式设置",
  "purpose": "MQTT message: drc_camera_night_mode_set",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "drc_camera_night_mode_set",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "payload_index",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机枚举值。非标准的 device_mode_key，格式为 {type-subtype-gimbalindex}，可以参考[产品支持](建议使用M4D（98-0-0）和M4TD（99-0-0））",
      "constraints": "{\"length\":\"\"}",
      "schema": "text"
    },
    {
      "name": "mode",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "自动模式根据进光量自动开启",
      "constraints": "{\"0\":\"关闭\",\"1\":\"开启\",\"2\":\"自动\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "seq": 1,
        "method": "drc_camera_night_mode_set",
        "data": {
          "payload_index": "99-0-0",
          "mode": 0
        }
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "seq": 1,
        "method": "drc_camera_night_mode_set",
        "data": {
          "result": 0
        }
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/20.dock3/190.remote-control.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock3/remote-control.html",
