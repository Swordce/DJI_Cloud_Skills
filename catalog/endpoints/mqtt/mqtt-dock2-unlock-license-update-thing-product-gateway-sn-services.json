    "asset_sha256": "8881c120b1e469bda961b9d29587a1768db87e38fdd72ea767d88e42dc4db93a",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
