{
  "id": "mqtt-dock2-sim-slot-switch-thing-product-gateway-sn-services",
  "name": "eSIM 和 SIM 切换",
  "purpose": "MQTT services: sim_slot_switch",
  "protocol": "mqtt",
  "module": "cmd",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/services",
    "direction": "down",
    "method": "sim_slot_switch",
    "reply_topic": "thing/product/{gateway_sn}/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "imei",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "标识要操作的 Dongle",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "device_type",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "标识要操作的目标设备",
      "constraints": "{\"dock\":\"设置机场 Dongle\",\"drone\":\"设置飞行器 Dongle\"}",
      "schema": "enum_string"
    },
    {
      "name": "sim_slot",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "在使用实体 SIM 卡和使用 eSIM 之间切换",
      "constraints": "{\"1\":\"实体 SIM 卡\",\"2\":\"eSIM\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/70.cmd.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock2/cmd.html",
    "sha256": "3c98cdd8530bd565aaf0663d8e9a826b41bd24d2f31ed246e681ab34e64a0c84",
    "asset_sha256": "10b5d3e33a5e20cfa2e7bb8f3cea1cd4e1c3c886ef3405418fee52001a69e3d5",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
