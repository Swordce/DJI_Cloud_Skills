      "constraints": "{\"max\":\"\",\"min\":\"\",\"step\":\"\",\"unit_name\":\"秒 / s\"}",
      "schema": "int",
      "parent": "camera_state"
    },
    {
      "name": "recording_state",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "录像状态",
      "constraints": "{\"0\":\"空闲\",\"1\":\"录像中\"}",
      "schema": "enum_int",
      "parent": "camera_state"
    },
    {
      "name": "photo_state",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "拍照状态",
      "constraints": "{\"0\":\"空闲\",\"1\":\"拍照中\"}",
      "schema": "enum_int",
      "parent": "camera_state"
