      "constraints": "{\"max\":\"\",\"min\":\"\",\"step\":\"\",\"unit_name\":\"秒 / s\"}",
      "schema": "int",
      "parent": "camera_state"
    },
    {
      "name": "video_resolution",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
