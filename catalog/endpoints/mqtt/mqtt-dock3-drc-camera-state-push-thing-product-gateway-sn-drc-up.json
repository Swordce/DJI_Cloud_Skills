{
  "id": "mqtt-dock3-drc-camera-state-push-thing-product-gateway-sn-drc-up",
  "name": "相机状态上报",
  "purpose": "MQTT message: drc_camera_state_push",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/drc/up",
    "direction": "up",
    "method": "drc_camera_state_push",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "camera_state",
      "in": "payload",
      "type": "object",
