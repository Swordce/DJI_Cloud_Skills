{
  "id": "mqtt-dock3-heart-beat-thing-product-gateway-sn-drc-down",
  "name": "DRC-心跳",
  "purpose": "MQTT message: heart_beat",
  "protocol": "mqtt",
  "module": "drc",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "heart_beat",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "seq",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "递增的序号，保证指令顺序执行",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "timestamp",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "业务方可以通过心跳协议判断 DRC 链路是否活跃，若一定期间未收到心跳回应可以判定 DRC 链路异常，对于 DRC 异常情况可以发起重试。若超过 1 分钟未收到业务方发送心跳协议，设备将会认为 DRC 链路处于空闲退出 DRC 链路。",
      "constraints": "{\"unit_name\":\"毫秒 / ms\"}",
      "schema": "int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "timestamp": 1670415891013
        },
        "method": "heart_beat",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "data": {
          "timestamp": 1670415891013
        },
        "method": "heart_beat",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/20.dock3/110.drc.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock3/drc.html",
    "sha256": "a7c097dfae7259a21d72664d1ca32f3e37a2569369666762c0d3816a6ed51d9c",
    "asset_sha256": "0a6630ded545dc0b4034723d74858f6d9661194bf5ac63508dc1e6c8a34d8e64",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
