{
  "id": "mqtt-dock3-speaker-audio-play-start-thing-product-gateway-sn-services",
  "name": "喊话器-开始播放音频",
  "purpose": "MQTT services: speaker_audio_play_start",
  "protocol": "mqtt",
  "module": "psdk",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/services",
    "direction": "down",
    "method": "speaker_audio_play_start",
    "reply_topic": "thing/product/{gateway_sn}/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "psdk_index",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "psdk 负载设备索引",
      "constraints": "{\"min\":0}",
      "schema": "int"
    },
    {
      "name": "file",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "音频文件",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "name",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件名",
      "constraints": "{}",
      "schema": "text",
      "parent": "file"
    },
    {
      "name": "url",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "文件下载链接",
      "constraints": "{}",
      "schema": "text",
      "parent": "file"
    },
    {
      "name": "md5",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "音频文件的md5校验和, 用作机场唯一标识",
      "constraints": "",
      "schema": "text",
      "parent": "file"
    },
    {
      "name": "format",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "喊话器输入文件格式",
      "constraints": "{\"pcm\":\"pcm 格式\"}",
      "schema": "enum_string",
      "parent": "file"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "data": {
          "file": {
            "format": "pcm",
            "md5": "b38257017001f45ec064b5157b2e4416",
            "name": "20230720162718",
            "url": "https://example.com/5a6f9d4b-2a38-4b4b-86f9-3a678da0bf4a/3dd27366-bf21-41a7-9f07-62b74f2e93a7/fe2f2474-720a-4122-a552-010e1ed08920/20230720162718.webm.pcm"
          },
          "psdk_index": 2
        },
        "method": "speaker_audio_play_start",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
        "timestamp": 1689912303287
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp:": 1654070968655,
        "method": "speaker_audio_play_start"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
