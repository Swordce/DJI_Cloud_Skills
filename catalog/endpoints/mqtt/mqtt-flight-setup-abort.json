{
  "id": "mqtt-flight-setup-abort",
  "name": "取消准备中的任务",
  "purpose": "MQTT services: flight_setup_abort",
  "protocol": "mqtt",
  "module": "wayline",
  "operation": {
    "action": "publish",
    "topic": "thing/product/*{gateway_sn}*/services",
    "direction": "down",
    "method": "flight_setup_abort",
    "reply_topic": "thing/product/*{gateway_sn}*/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "0: Success 326108: 当前状态不支持，326109:因飞行器已经起飞，不支持取消，可通过返航按钮取消",
      "constraints": "{\"max\":\"\",\"min\":\"\",\"step\":\"\",\"unit_name\":null}",
      "schema": "int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1234567890123,
        "method": "flight_setup_abort"
      },
      "source": "official"
    },
    {
      "kind": "response",
      "format": "json",
      "value": {
        "bid": "00000000-0000-0000-0000-000000000000",
        "data": {
          "result": 0
        },
        "method": "flight_setup_abort",
        "tid": "00000000-0000-0000-0000-000000000000",
        "timestamp": 0
      },
      "source": "generated_from_schema"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/50.wayline.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/50.wayline.md"
  }
}
