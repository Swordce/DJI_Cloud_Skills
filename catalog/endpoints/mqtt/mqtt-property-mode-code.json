{
  "id": "mqtt-property-mode-code",
  "name": "mode_code",
  "purpose": "飞行器状态",
  "protocol": "mqtt",
  "module": "device-properties",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{device_sn}/state|osd",
    "direction": "up",
    "method": "property_report"
  },
  "parameters": [
    {
      "name": "mode_code",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "飞行器状态",
      "constraints": "{\"0\":\"待机\",\"1\":\"起飞准备\",\"2\":\"起飞准备完毕\",\"3\":\"手动飞行\",\"4\":\"自动起飞\",\"5\":\"航线飞行\",\"6\":\"全景拍照\",\"7\":\"智能跟随\",\"8\":\"ADS-B 躲避\",\"9\":\"自动返航\",\"10\":\"自动降落\",\"11\":\"强制降落\",\"12\":\"三桨叶降落\",\"13\":\"升级中\",\"14\":\"未连接\",\"15\":\"APAS\",\"16\":\"虚拟摇杆状态\",\"17\":\"指令飞行\",\"18\":\"空中 RTK 收敛模式\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "payload_field": "data.mode_code"
    }
  ],
  "errors": [],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "00000000-0000-0000-0000-000000000000",
        "data": {
          "mode_code": 0
        },
        "method": "property_report",
        "tid": "00000000-0000-0000-0000-000000000000",
        "timestamp": 0
      },
      "source": "generated_from_schema"
    },
    {
      "kind": "response",
      "format": "json",
      "value": {
        "bid": "00000000-0000-0000-0000-000000000000",
        "data": {
          "result": 0
        },
        "method": "property_report",
        "tid": "00000000-0000-0000-0000-000000000000",
        "timestamp": 0
      },
      "source": "generated_from_schema"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2",
    "pilot"
  ],
