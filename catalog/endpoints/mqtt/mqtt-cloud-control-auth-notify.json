{
  "id": "mqtt-cloud-control-auth-notify",
  "name": "请求授权结果通知",
  "purpose": "MQTT events: cloud_control_auth_notify",
  "protocol": "mqtt",
  "module": "drc",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{gateway_sn}*/events",
    "direction": "up",
    "method": "cloud_control_auth_notify",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "非0代表错误",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "output",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "输出",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "任务状态",
      "constraints": "{\"canceled\":\"有其他用户发起授权请求弹窗，本次弹窗被取消。\",\"failed\":\"错误或者用户拒绝\",\"ok\":\"用户同意\"}",
      "schema": "enum_string"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/events",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "status": "ok"
          },
          "result": 0
        },
        "method": "cloud_control_auth_notify",
        "need_reply": 0,
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1704038400000
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "pilot"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/30.drc.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/30.drc.md"
  }
}
