{
  "id": "mqtt-property-flighttask-step-code",
  "name": "flighttask_step_code",
  "purpose": "机场任务状态",
  "protocol": "mqtt",
  "module": "device-properties",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/*{device_sn}*/state 状态数据:设备在状态变化时上报",
    "direction": "up",
    "method": "property_report"
  },
  "parameters": [
    {
      "name": "flighttask_step_code",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "机场任务状态",
      "constraints": "{\"0\":\"作业准备中\",\"1\":\"飞行作业中\",\"2\":\"作业后状态恢复\",\"3\":\"自定义飞行区更新中\",\"4\":\"地形障碍物更新中\",\"5\":\"任务空闲\",\"255\":\"飞行器异常\",\"256\":\"未知状态\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
