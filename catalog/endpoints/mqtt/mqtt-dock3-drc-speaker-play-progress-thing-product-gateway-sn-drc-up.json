{
  "id": "mqtt-dock3-drc-speaker-play-progress-thing-product-gateway-sn-drc-up",
  "name": "喊话器—音频播放进度",
  "purpose": "MQTT message: drc_speaker_play_progress",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/drc/up",
    "direction": "up",
    "method": "drc_speaker_play_progress",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "psdk_index",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "psdk 负载设备索引",
      "constraints": "依据设备推送",
      "schema": "int"
    },
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "结果",
      "constraints": "{\"0\":\"成功\"}",
      "schema": "enum_int"
    },
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "状态",
      "constraints": "{\"failed\":\"失败\",\"in_progress\":\"进度中\",\"success\":\"成功\"}",
      "schema": "enum_string"
    },
    {
      "name": "progress",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "step_key",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "步骤",
      "constraints": "{\"change_work_mode\":\"工作\",\"download\":\"下载\",\"encoding\":\"转换\",\"play\":\"播放\",\"tts_processing\":\"tts播放\",\"upload\":\"上传\"}",
      "schema": "enum_string",
      "parent": "progress"
    },
    {
      "name": "percent",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度",
      "constraints": "{\"max\":\"100\",\"min\":\"1\"}",
      "schema": "int",
      "parent": "progress"
    },
    {
      "name": "md5",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "验证",
      "constraints": "",
      "schema": "string"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock3"
  ],
  "deprecated": false,
