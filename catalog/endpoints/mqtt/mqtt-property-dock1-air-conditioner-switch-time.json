{
  "id": "mqtt-property-dock1-air-conditioner-switch-time",
  "name": "switch_time",
  "purpose": "模式切换顺序为准备模式、工作（制冷、制热、除湿）模式、退出模式、空闲模式。本属性将上报，可以切换下一个模式指令还需要等待的时间。例如当前机场空调在进入制冷模式后，必须制冷5分钟后才可以退出制冷模式，本属性将上报还需要多久退出制冷模式，为0表示随时可退出",
  "protocol": "mqtt",
  "module": "device-properties",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{device_sn}/osd",
    "set_topic": null,
