{
  "id": "mqtt-ota-create",
  "name": "固件升级",
  "purpose": "MQTT services: ota_create",
  "protocol": "mqtt",
  "module": "firmware",
  "operation": {
    "action": "publish",
    "topic": "thing/product/*{gateway_sn}*/services",
    "direction": "down",
    "method": "ota_create",
    "reply_topic": "thing/product/*{gateway_sn}*/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "devices",
      "in": "payload",
      "type": "array",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件升级设备集合",
      "constraints": "{\"size\": 2, \"item_type\": struct}",
      "schema": "array"
    },
    {
      "name": "sn",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "设备序列号（SN）",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text"
    },
    {
      "name": "product_version",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件版本",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text"
    },
    {
      "name": "file_url",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件下载地址",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text"
    },
    {
      "name": "md5",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件 MD5",
      "constraints": "{\"length\":\"10240\"}",
      "schema": "text"
    },
    {
      "name": "file_size",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件大小",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "file_name",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件文件名称",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "firmware_upgrade_type",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "固件升级类型",
      "constraints": "{\"2\":\"一致性升级\",\"3\":\"普通升级\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "devices": [
            {
              "file_name": "wm245_1.00.223.zip",
              "file_size": 653467234,
              "file_url": "https://s3.com/xxx.zip",
              "firmware_upgrade_type": 2,
              "md5": "abcdefabcdefabcdef",
              "product_version": "1.00.223",
              "sn": "drone_sn"
            },
            {
              "firmware_upgrade_type": 3,
              "product_version": "1.00.223",
              "sn": "dock_sn"
            }
          ]
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "ota_create"
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "status": "in_progress"
          },
          "result": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "ota_create"
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock1",
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/80.firmware.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/00.dock1/80.firmware.md"
  },
  "alternate_sources": [
    {
      "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/80.firmware.md",
      "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/80.firmware.md"
    }
  ]
}
