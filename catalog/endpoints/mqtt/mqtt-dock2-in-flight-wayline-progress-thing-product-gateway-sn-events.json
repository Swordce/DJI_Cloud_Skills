{
  "id": "mqtt-dock2-in-flight-wayline-progress-thing-product-gateway-sn-events",
  "name": "空中下发航线状态上报",
  "purpose": "MQTT events: in_flight_wayline_progress",
  "protocol": "mqtt",
  "module": "wayline",
  "operation": {
