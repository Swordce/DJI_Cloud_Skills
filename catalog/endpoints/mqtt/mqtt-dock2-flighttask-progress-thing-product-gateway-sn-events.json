{
  "id": "mqtt-dock2-flighttask-progress-thing-product-gateway-sn-events",
  "name": "上报航线任务进度",
  "purpose": "MQTT events: flighttask_progress",
  "protocol": "mqtt",
  "module": "wayline",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/events",
    "direction": "up",
    "method": "flighttask_progress",
    "reply_topic": null,
    "reply_direction": null
  },
  "parameters": [
    {
      "name": "ext",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "扩展内容",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "current_waypoint_index",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前执行到的航点数",
      "constraints": "",
      "schema": "int",
      "parent": "ext"
    },
    {
      "name": "wayline_mission_state",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航线任务状态",
      "constraints": "{\"0\":\"断连\",\"1\":\"不支持该航点\",\"2\":\"航线准备状态,可上传文件,可执行已有文件\",\"3\":\"航线文件上传中\",\"4\":\"触发开始命令，飞行器触发读航线等逻辑，还未开始任务，处于准备状态\",\"5\":\"进入航线,到第一个航点\",\"6\":\"航线执行\",\"7\":\"航线中断，触发条件：1.用户主动暂停 2.飞控异常\",\"8\":\"航线恢复\",\"9\":\"航线停止\"}",
      "schema": "enum_int",
      "parent": "ext"
    },
    {
      "name": "media_count",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "本次航线任务执行产生的媒体文件数量",
      "constraints": "",
      "schema": "int",
      "parent": "ext"
    },
    {
      "name": "track_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航迹 ID",
      "constraints": "",
      "schema": "text",
      "parent": "ext"
    },
    {
      "name": "flight_id",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "任务 ID",
      "constraints": "",
      "schema": "text",
      "parent": "ext"
    },
    {
      "name": "break_point",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "可选字段，用于告知云端本次航线任务断点信息",
      "constraints": "",
      "schema": "struct",
      "parent": "ext"
    },
    {
      "name": "index",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "断点序号",
      "constraints": "",
      "schema": "int",
      "parent": "break_point"
    },
    {
      "name": "state",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "断点状态",
      "constraints": "{\"0\":\"在航段上\",\"1\":\"在航点上\"}",
      "schema": "enum_int",
      "parent": "break_point"
    },
    {
      "name": "progress",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "当前航段进度",
      "constraints": "{\"max\":\"1.0\",\"min\":\"0\",\"step\":\"\",\"unit_name\":null}",
      "schema": "float",
      "parent": "break_point"
    },
    {
      "name": "wayline_id",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "航线 ID",
      "constraints": "",
      "schema": "int",
      "parent": "break_point"
    },
    {
      "name": "break_reason",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "中断原因",
      "constraints": "{\"0\":\"无异常\",\"1\":\"Mission ID 不存在，该航线任务未执行\",\"2\":\"不常见错误，建议联系技术支持\",\"4\":\"请求开始/恢复航线任务时，航线文件加载出错，请重新尝试上传文件开始或联系技术支持\",\"5\":\"请求查询断点信息时，查询断点文件失败。请求恢复航线任务时，解析断点类型失败\",\"6\":\"请求开始/结束航线任务时，cmd参数有误，协议请求的指令有误。请求恢复航线任务时，解析断点类型失败\",\"7\":\"请求开始/恢复航线任务时，解析 wpmz 文件超时，请重试\",\"257\":\"航线已经开始，不能再次开始\",\"258\":\"此状态下无法中断航线，只允许在航线执行状态时暂停航线\",\"259\":\"航线未开始，不能结束航线\",\"261\":\"飞行任务冲突，无法获取飞行器控制权，不允许在降落和返航中开始航线\",\"262\":\"该状态下无法恢复航线，只允许在航线暂停状态时恢复航线\",\"513\":\"飞行器超过限高高度\",\"514\":\"飞行器超过限远距离\",\"515\":\"航线穿过限飞区，机场无法执行飞行任务\",\"516\":\"飞行器触发限低\",\"517\":\"飞行器触发避障\",\"518\":\"RTK 信号差\",\"519\":\"接近禁飞区边界\",\"521\":\"超过机场限飞区限高\",\"522\":\"航线请求起飞失败\",\"523\":\"起飞任务执行失败\",\"524\":\"请求航线任务失败\",\"526\":\"请求航线 RTK 收敛任务失败\",\"527\":\"航线 RTK 收敛任务运行失败\",\"529\":\"有障碍物或者禁飞区域，导致航线无法到达\",\"769\":\"GPS 信号弱\",\"770\":\"遥控器档位不在 N 档\",\"771\":\"返航点未刷新\",\"772\":\"当前电量过低无法开始任务\",\"773\":\"低电量返航导致航线中断\",\"775\":\"遥控器与飞行器失联\",\"778\":\"飞行器在地面起桨，不允许开始航线\",\"779\":\"实时仿地过程中，相机状态异常（如过亮，过暗，两侧亮度不一致）\",\"780\":\"实时仿地用户设置的仿地高度不合法（大于 200 m 或者小于 30 m）\",\"781\":\"实时仿地过程中全局地图计算出错\",\"784\":\"大风返航导致航线中断\",\"1281\":\"用户退出\",\"1282\":\"用户中断\",\"1283\":\"用户触发返航\",\"1539\":\"开始信息（航点 index 或者 progress）错误\",\"1540\":\"使用不支持的坐标系\",\"1541\":\"使用不支持的高度模式\",\"1542\":\"使用不支持的过渡航线模式\",\"1543\":\"使用不支持的 yaw 模式\",\"1544\":\"使用不支持的 yaw 方向调转模式\",\"1545\":\"使用不支持的航点类型\",\"1546\":\"首尾点不能使用协调转弯类型\",\"1547\":\"航线全局速度超过合理范围\",\"1548\":\"航点数量异常\",\"1549\":\"经纬度数据异常\",\"1550\":\"转弯截距异常\",\"1551\":\"航段最大速度超过合理范围\",\"1552\":\"航段目标速度超过合理范围\",\"1553\":\"航点 yaw 角度超过合理范围\",\"1555\":\"断点续飞的 mission_id 输入错误\",\"1556\":\"断点续飞的 progress 信息输入错误\",\"1557\":\"断点续飞的任务状态异常\",\"1558\":\"断点续飞的航点 index 信息输入错误\",\"1559\":\"断点续飞的经纬度信息输入错误\",\"1560\":\"断点续飞的航点 yaw 输入错误\",\"1561\":\"断点续飞的标志位设置错误\",\"1563\":\"航线生成失败\",\"1564\":\"航线运行失败\",\"1565\":\"航线避障紧急刹停\",\"1588\":\"无法识别的动作类型\",\"1595\":\"动作 ID 不能重复\",\"1598\":\"动作 ID 值不能为 65535\",\"1602\":\"动作组数量超过合理范围\",\"1603\":\"动作组生效范围错误\",\"1606\":\"断点续飞中动作 index 超过合理范围\",\"1608\":\"断点信息中触发器运行结果异常\",\"1609\":\"断点续飞中动作组 ID 信息不能重复\",\"1610\":\"断点续飞中动作组位置不能重复\",\"1611\":\"断点续飞中动作组位置超过合理范围\",\"1612\":\"续飞中动作 ID 不在断点信息中\",\"1613\":\"断点续飞中不能修改动作状态为中断\",\"1614\":\"断点信息错误导致续飞失败\",\"1634\":\"无法识别的动作类型\",\"1649\":\"无法识别的触发器类型\",\"65534\":\"未知内部错误\",\"65535\":\"未知内部错误\"}",
      "schema": "enum_int",
      "parent": "break_point"
    },
    {
      "name": "latitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "断点纬度",
      "constraints": "{\"max\":\"90\",\"min\":\"-90\",\"step\":\"\",\"unit_name\":\"度 / °\"}",
      "schema": "float",
      "parent": "break_point"
    },
    {
      "name": "longitude",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "断点经度",
      "constraints": "{\"max\":\"180\",\"min\":\"-180\",\"step\":\"\",\"unit_name\":\"度 / °\"}",
      "schema": "float",
      "parent": "break_point"
    },
    {
      "name": "height",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "断点相对地球椭球面高度",
      "constraints": "{\"unit_name\":\"米 / m\"}",
      "schema": "float",
      "parent": "break_point"
    },
    {
      "name": "attitude_head",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "断点偏航轴角度",
      "constraints": "",
      "schema": "float",
      "parent": "break_point"
    },
    {
      "name": "wayline_id",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "包括进入航线的过渡阶段，例如0代表飞行器正在进入或者已经在执行第一条航线",
      "constraints": "",
      "schema": "int",
      "parent": "ext"
    },
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "任务状态",
      "constraints": "{\"canceled\":\"取消或终止\",\"failed\":\"失败\",\"in_progress\":\"执行中\",\"ok\":\"执行成功\",\"partially_done\":\"部分完成\",\"paused\":\"暂停\",\"rejected\":\"拒绝\",\"sent\":\"已下发\",\"timeout\":\"超时\"}",
      "schema": "enum_string"
    },
    {
      "name": "progress",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "current_step",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "执行步骤",
      "constraints": "{\"0\":\"初始状态\",\"1\":\"启动前检查，飞行器是否在执行航线中\",\"2\":\"启动前检查，机场是否退出工作模式\",\"3\":\"启动前检查，航线执行中\",\"4\":\"启动前检查，返航中\",\"5\":\"航线执行进入准备状态，开始等待任务下发\",\"6\":\"机场进入工作状态\",\"7\":\"进入开机检查准备工作和开盖准备工作\",\"8\":\"图传远程对频\",\"9\":\"等待飞行系统准备就绪，推送连接建立\",\"10\":\"等待 RTK 源监听有值上报\",\"11\":\"检查 RTK 源是否是机场源，如果不是要重新设置\",\"12\":\"等待飞行控制权通知\",\"13\":\"机场无控制权，抢夺飞行器控制权\",\"14\":\"自定义飞行区一致性检查\",\"15\":\"离线地图一致性检查\",\"16\":\"获取最新 KMZ URL\",\"17\":\"下载 KMZ\",\"18\":\"KMZ 上传中\",\"19\":\"染色配置\",\"20\":\"飞行器起飞参数设置，备降点设置，起飞高度设置，染色设置\",\"21\":\"飞行器 flyto 起飞参数设置\",\"22\":\"起飞机场检查降落机场准备状态\",\"23\":\"Home 点设置\",\"24\":\"触发执行航线\",\"26\":\"进入返航的检查准备工作\",\"27\":\"飞行器降落机场\",\"28\":\"降落以后的关盖\",\"29\":\"机场退出工作模式\",\"30\":\"机场异常恢复\",\"31\":\"机场上传飞行系统日志\",\"32\":\"相机录像状态检查\",\"33\":\"获取媒体文件数量\",\"34\":\"机场起飞开盖的异常恢复\",\"35\":\"通知任务结果\",\"36\":\"日志列表拉取 - 飞行器列表\",\"37\":\"日志列表拉取 - 拉取机场列表\",\"38\":\"日志列表拉取 - 上传日志列表结果\",\"39\":\"日志拉取-拉取飞行器日志\",\"40\":\"日志拉取-拉取机场日志\",\"41\":\"日志拉取-压缩飞行器日志\",\"42\":\"日志拉取-压缩机场日志\",\"43\":\"日志拉取-上传飞行器日志\",\"44\":\"日志拉取-上传机场日志\",\"45\":\"日志拉取-通知结果\",\"46\":\"自定义飞行区文件更新准备中\",\"47\":\"自定义飞行区更新中\",\"48\":\"离线地图更新准备中\",\"49\":\"离线地图更新中\",\"65533\":\"结束后等待服务回包\",\"65534\":\"无具体状态\",\"65535\":\"UNKNOWN\"}",
      "schema": "enum_int",
      "parent": "progress"
    },
    {
      "name": "percent",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度值",
      "constraints": "{\"max\":\"100\",\"min\":\"0\",\"step\":\"1\"}",
      "schema": "int",
      "parent": "progress"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
