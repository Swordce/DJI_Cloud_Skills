{
  "id": "mqtt-dock2-esim-operator-switch-thing-product-gateway-sn-events",
  "name": "eSIM 的运营商切换进度",
  "purpose": "MQTT events: esim_operator_switch",
  "protocol": "mqtt",
  "module": "cmd",
  "operation": {
    "action": "subscribe",
    "topic": "thing/product/{gateway_sn}/events",
    "direction": "up",
    "method": "esim_operator_switch",
    "reply_topic": "thing/product/{gateway_sn}/events_reply",
    "reply_direction": "down"
  },
  "parameters": [
    {
      "name": "result",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "返回码",
      "constraints": "",
      "schema": "int"
    },
    {
      "name": "output",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "输出",
      "constraints": "",
      "schema": "struct"
    },
    {
      "name": "status",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "任务状态",
      "constraints": "{\"canceled\":\"取消或终止\",\"failed\":\"失败\",\"in_progress\":\"执行中\",\"ok\":\"执行成功\",\"paused\":\"暂停\",\"rejected\":\"拒绝\",\"sent\":\"已下发\",\"timeout\":\"超时\"}",
      "schema": "enum_string",
      "parent": "output"
    },
    {
      "name": "progress",
      "in": "payload",
      "type": "object",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度",
      "constraints": "",
      "schema": "struct",
      "parent": "output"
    },
    {
      "name": "percent",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "进度百分比",
      "constraints": "{\"max\":\"100\",\"min\":\"0\",\"step\":\"1\",\"unit_name\":\"百分比 / %\"}",
      "schema": "int",
      "parent": "progress"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/events_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "output": {
            "progress": {
              "percent": 0
            },
            "status": "in_progress"
          },
          "result": 0
        },
        "gateway": "dock_sn",
        "method": "esim_operator_switch",
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "method": "esim_operator_switch",
        "tid": "6a7bfe89-c386-4043-b600-b518e10096cc",
        "bid": "42a19f36-5117-4520-bd13-fd61d818d52e",
        "timestamp": "1234567890123",
        "data": {
          "result": 0
        }
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/70.cmd.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/dock-to-cloud/mqtt/dock/dock2/cmd.html",
    "sha256": "3c98cdd8530bd565aaf0663d8e9a826b41bd24d2f31ed246e681ab34e64a0c84",
    "asset_sha256": "10b5d3e33a5e20cfa2e7bb8f3cea1cd4e1c3c886ef3405418fee52001a69e3d5",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
