{
  "id": "mqtt-dock2-unlock-license-list-thing-product-gateway-sn-services",
  "name": "获取设备的解禁证书列表",
  "purpose": "MQTT services: unlock_license_list",
  "protocol": "mqtt",
  "module": "flysafe",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/services",
    "direction": "down",
    "method": "unlock_license_list",
    "reply_topic": "thing/product/{gateway_sn}/services_reply",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "device_model_domain",
      "in": "payload",
      "type": "integer",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "从飞行器拉取的是成功导入飞行器的解禁证书；从机场拉取的是 Flysafe 官网申请通过的解禁证书。",
      "constraints": "{\"0\":\"飞行器\",\"3\":\"机场\"}",
      "schema": "enum_int"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/services_reply",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "bid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "data": {
          "device_model_domain": 0
        },
        "tid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx",
        "timestamp": 1654070968655,
        "method": "unlock_license_list"
      },
      "source": "official"
    },
