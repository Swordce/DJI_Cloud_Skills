{
  "id": "mqtt-dji-rc-plus-2-drc-camera-frame-zoom-thing-product-gateway-sn-drc-down",
  "name": "负载控制—框选变焦",
  "purpose": "MQTT message: drc_camera_frame_zoom",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "drc_camera_frame_zoom",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "payload_index",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机枚举",
      "constraints": "{\"length\":\"\"}",
      "schema": "text"
    },
    {
      "name": "camera_type",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机类型",
      "constraints": "{\"ir\":\"红外\",\"wide\":\"广角\",\"zoom\":\"变焦\"}",
      "schema": "enum_string"
    },
    {
      "name": "locked",
      "in": "payload",
      "type": "boolean",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "机头和云台的相对关系是否锁定",
      "constraints": "{\"0\":\"仅云台转，机身不转\",\"1\":\"锁定机头，云台和机身一起转\"}",
      "schema": "bool"
    },
    {
      "name": "x",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "目标框左上角点坐标x",
      "constraints": "{\"max\":\"1\",\"min\":\"0\",\"step\":\"0.000001\",\"unit_name\":\"无 / \"}",
      "schema": "float"
    },
    {
      "name": "y",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "目标框左上角点坐标y",
      "constraints": "{\"max\":\"1\",\"min\":\"0\",\"step\":\"0.000001\",\"unit_name\":\"无 / \"}",
      "schema": "float"
    },
    {
      "name": "width",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "目标框宽度",
      "constraints": "{\"max\":\"1\",\"min\":\"0\",\"step\":\"0.000001\",\"unit_name\":\"无 / \"}",
      "schema": "float"
    },
    {
      "name": "height",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "目标框高度",
      "constraints": "{\"max\":\"1\",\"min\":\"0\",\"step\":\"0.000001\",\"unit_name\":\"无 / \"}",
      "schema": "float"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "camera_type": "zoom",
          "height": 0.5,
          "locked": true,
          "payload_index": "89-0-0",
          "width": 0.8,
          "x": 0.5,
          "y": 0.5
        },
        "method": "drc_camera_frame_zoom",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_camera_frame_zoom",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dji-rc-plus-2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/40.dji-rc-plus-2/40.remote-control.md",
    "url": "https://developer.dji.com/doc/cloud-api-tutorial/cn/api-reference/pilot-to-cloud/mqtt/dji-rc-plus-2/remote-control.html",
    "sha256": "474d36810f777c08b1b3fb174e4189f13771bddafbae9733e80340129722c51c",
    "asset_sha256": "144d7b7a36f3bdb787b59cd873902ee5cababf391e650ddba7dcec46adfa9cd2",
    "snapshot_sha256": "7f856e08f7f48e10f75fe491ffdcc94af4f54b8ee03ac2fce2d66739e41fe598",
    "version": "1.16.1"
  }
}
