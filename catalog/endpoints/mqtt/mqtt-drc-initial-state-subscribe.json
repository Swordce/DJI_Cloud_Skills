{
  "id": "mqtt-drc-initial-state-subscribe",
  "name": "drc初始状态订阅",
  "purpose": "MQTT message: drc_initial_state_subscribe",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/*{gateway_sn}*/drc/down",
    "direction": "down",
    "method": "drc_initial_state_subscribe",
    "reply_topic": "thing/product/*{gateway_sn}*/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "null",
      "in": "payload",
      "type": "number",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "null",
      "constraints": "",
      "schema": "double"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {},
        "method": "drc_initial_state_subscribe",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_initial_state_subscribe",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock2",
    "pilot"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/40.remote-control.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/20.rc-pro/40.remote-control.md"
  },
  "alternate_sources": [
