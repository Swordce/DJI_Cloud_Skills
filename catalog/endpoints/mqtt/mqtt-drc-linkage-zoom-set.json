{
  "id": "mqtt-drc-linkage-zoom-set",
  "name": "负载控制—红外联动变焦",
  "purpose": "MQTT message: drc_linkage_zoom_set",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/*{gateway_sn}*/drc/down",
    "direction": "down",
    "method": "drc_linkage_zoom_set",
    "reply_topic": "thing/product/*{gateway_sn}*/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "payload_index",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "相机枚举值。非标准的 device_mode_key，格式为 {type-subtype-gimbalindex}，可以参考产品支持",
      "constraints": "",
      "schema": "text"
    },
    {
      "name": "state",
      "in": "payload",
      "type": "boolean",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "联动变焦状态",
      "constraints": "{\"0\":\"关闭\",\"1\":\"开启\"}",
      "schema": "bool"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/*{gateway_sn}*/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "payload_index": "81-0-0",
          "state": 0
        },
        "method": "drc_linkage_zoom_set",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_linkage_zoom_set",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dock2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/180.remote-control.md",
    "url": "https://github.com/dji-sdk/Cloud-API-Doc/blob/master/docs/cn/60.api-reference/20.dock-to-cloud/00.mqtt/20.dock/10.dock2/180.remote-control.md"
  }
}
