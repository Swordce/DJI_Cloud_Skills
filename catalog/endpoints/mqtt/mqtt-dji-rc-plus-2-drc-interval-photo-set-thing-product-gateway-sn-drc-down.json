{
  "id": "mqtt-dji-rc-plus-2-drc-interval-photo-set-thing-product-gateway-sn-drc-down",
  "name": "负载控制—设置定时拍",
  "purpose": "MQTT message: drc_interval_photo_set",
  "protocol": "mqtt",
  "module": "remote-control",
  "operation": {
    "action": "publish",
    "topic": "thing/product/{gateway_sn}/drc/down",
    "direction": "down",
    "method": "drc_interval_photo_set",
    "reply_topic": "thing/product/{gateway_sn}/drc/up",
    "reply_direction": "up"
  },
  "parameters": [
    {
      "name": "interval",
      "in": "payload",
      "type": "string",
      "required": null,
      "required_status": "not_specified_by_source",
      "description": "不同照片尺寸取值范围不一样（例如照片尺寸设置 8k 的时候，定时拍照间隔无法设置 0.7s、1s）",
      "constraints": "{\"1\":\"1s\",\"2\":\"2s\",\"3\":\"3s\",\"5\":\"5s\",\"7\":\"7s\",\"10\":\"10s\",\"15\":\"15s\",\"20\":\"20s\",\"30\":\"30s\",\"60\":\"60s\",\"0.7\":\"0.7s\"}",
      "schema": "enum_string"
    }
  ],
  "authentication": {
    "type": "broker_credentials",
    "location": "connection",
    "name": "username/password"
  },
  "responses": [
    {
      "transport": "mqtt",
      "topic": "thing/product/{gateway_sn}/drc/up",
      "correlation": [
        "tid",
        "bid",
        "method"
      ]
    }
  ],
  "errors": [
    {
      "code": "data.result != 0",
      "meaning": "See catalog/error-codes.json",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "request",
      "format": "json",
      "value": {
        "data": {
          "interval": 1,
          "payload_index": "89-0-0"
        },
        "method": "drc_interval_photo_set",
        "seq": 1
      },
      "source": "official"
    },
    {
      "kind": "reply",
      "format": "json",
      "value": {
        "data": {
          "result": 0
        },
        "method": "drc_interval_photo_set",
        "seq": 1
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": true,
    "max_attempts": 2,
    "backoff": "exponential_jitter",
    "retry_on": [
      "reply_timeout",
      "broker_disconnect"
    ],
    "notes": "Reuse tid/bid for correlation and deduplicate replies; never blindly replay flight, control, or upgrade commands."
  },
  "compatibility": [
    "dji-rc-plus-2"
  ],
  "deprecated": false,
  "source": {
    "file": "docs/cn/60.api-reference/10.pilot-to-cloud/00.mqtt/40.dji-rc-plus-2/40.remote-control.md",
