{
  "id": "http-post-storage-api-v1-workspaces-workspace-id-sts",
  "name": "生成上传文件临时凭证",
  "purpose": "POST /storage/api/v1/workspaces/{workspace_id}/sts",
  "protocol": "http",
  "module": "waypoint-management",
  "operation": {
    "method": "POST",
    "path": "/storage/api/v1/workspaces/{workspace_id}/sts",
    "content_type": "application/json"
  },
  "parameters": [
    {
      "name": "workspace_id",
      "in": "path",
      "type": "string",
      "required": true,
      "required_status": "required",
      "description": "工作空间id",
      "constraints": "",
      "schema": "string"
    },
    {
      "name": "x-auth-token",
      "in": "header",
      "type": "string",
      "required": true,
      "required_status": "required",
      "description": "访问令牌",
      "constraints": "",
      "schema": "string"
    }
  ],
  "authentication": {
    "type": "token",
    "location": "header",
    "name": "X-Auth-Token"
  },
  "responses": [
    {
      "status": "200",
      "description": "OK",
      "schema": "storage.GetStsOutput",
      "fields": [
        {
          "name": "code",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "错误码",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "message",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "描述",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "data",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "返回内容",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "bucket",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "对象存储桶名称",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "credentials",
          "in": "response",
          "type": "string",
          "required": null,
          "required_status": "not_specified_by_source",
          "description": "凭证信息",
          "constraints": "none",
          "schema": "storage.Credentials"
        },
        {
          "name": "endpoint",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "对外服务的访问域名",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "object_key_prefix",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "文件在对象存储桶的key的前缀",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "provider",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "云厂商枚举值 * ali - 阿里云 * aws - 亚马逊云",
          "constraints": "none",
          "schema": "string"
        },
        {
          "name": "region",
          "in": "response",
          "type": "string",
          "required": false,
          "required_status": "optional",
          "description": "数据中心所在的地域,参考相应云厂商region枚举值",
          "constraints": "none",
          "schema": "string"
        }
      ]
    }
  ],
  "errors": [
    {
      "code": "400",
      "meaning": "invalid_request",
      "retry": false
    },
    {
      "code": "401",
      "meaning": "token_expired_or_invalid",
      "retry": false
    },
    {
      "code": "403",
      "meaning": "forbidden",
      "retry": false
    },
    {
      "code": "404",
      "meaning": "resource_not_found",
      "retry": false
    },
    {
      "code": "5xx",
      "meaning": "server_error",
      "retry": false
    }
  ],
  "examples": [
    {
      "kind": "response",
      "format": "json",
      "value": {
        "code": 0,
        "data": {
          "bucket": "string",
          "credentials": {
