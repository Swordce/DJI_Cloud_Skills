            "access_key_secret": "9NG2P2yJaUrck576CkdRoRbchKssJiZygi5D93CBsduY",
            "expire": 3600,
            "security_token": ""
          },
          "endpoint": "https://oss-cn-hangzhou.aliyuncs.com",
          "object_key_prefix": "5a6f9d4b-2a38-4b4b-86f9-3a678da0bf4a",
          "provider": "ali"
        },
        "message": "success"
      },
      "source": "official"
    },
    {
      "kind": "response",
      "format": "json",
      "value": {
        "code": 0,
        "message": "string",
        "data": {
          "bucket": "string",
          "credentials": {
            "access_key_id": "string",
            "access_key_secret": "string",
            "expire": 0,
            "security_token": "string"
          },
          "endpoint": "string",
          "object_key_prefix": "string",
          "provider": "ali",
          "region": "string"
        }
      },
      "source": "official"
    }
  ],
  "retry": {
    "automatic": false,
    "max_attempts": 1,
    "backoff": "exponential_jitter",
    "retry_on": [],
    "notes": "POST requires an application idempotency key or explicit confirmation before retry."
  },
