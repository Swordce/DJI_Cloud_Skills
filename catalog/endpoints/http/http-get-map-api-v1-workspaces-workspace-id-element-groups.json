{
  "id": "http-get-map-api-v1-workspaces-workspace-id-element-groups",
  "name": "获取元素列表",
  "purpose": "GET /map/api/v1/workspaces/{workspace_id}/element-groups",
  "protocol": "http",
  "module": "map-elements",
  "operation": {
    "method": "GET",
    "path": "/map/api/v1/workspaces/{workspace_id}/element-groups",
    "content_type": "application/json"
  },
  "parameters": [
    {
      "name": "group_id",
      "in": "query",
      "type": "string",
      "required": false,
      "required_status": "optional",
      "description": "元素组id（同一个元素组下可以包含多个地图元素，相当于给地图元素进行分组。在发起请求时，如果不带group_id参数，则服务端会把所有地图元素全部返回，如果指定了group_id，则只会返回指定的元素组内的元素集合）",
      "constraints": "",
      "schema": "string"
    },
    {
      "name": "is_distributed",
      "in": "query",
      "type": "boolean",
      "required": false,
      "required_status": "optional",
      "description": "元素组分发状态（默认为true）",
      "constraints": "",
      "schema": "boolean"
    },
    {
      "name": "workspace_id",
      "in": "path",
      "type": "string",
      "required": true,
      "required_status": "required",
      "description": "工作空间id",
      "constraints": "",
      "schema": "string"
    },
    {
